# PostgreSQL — obligatorio para Prisma y para iniciar sesión de admin
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pixelcraft_salon?schema=public"

# Vercel: Transaction pooler de Supabase (puerto 6543) + pgbouncer=true.
# El Session pooler (5432) se agota en serverless y el login admin falla.

# NextAuth — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXTAUTH_URL debe coincidir con el origen real (si next usa otro puerto, cambialo).
NEXTAUTH_SECRET="reemplazar-con-un-secreto-largo"
NEXTAUTH_URL="http://localhost:3000"

# URL pública de la app (SEO, sitemap, enlaces)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Correo transaccional (opcional). Sin RESEND_API_KEY se registra en consola y no se envía.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM="Pixel-Craft Salón <noreply@example.com>"

# Recordatorios (opcional). GET /api/cron/reminders con Authorization: Bearer CRON_SECRET
# CRON_SECRET=""

